# ============================================
# PeerBridge Server — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: Restrict registration to a specific university domain
ALLOWED_EMAIL_DOMAIN=.edu.pk

# ---------- Database (MySQL 8.0) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peerbridge

# ---------- JWT ----------
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=30d

# ---------- Email (NodeMailer SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- Peer Matching ----------
MATCH_MIN_TRUST_SCORE=30
MATCH_WEIGHT_SUBJECT=40
MATCH_WEIGHT_SEMESTER=25
MATCH_WEIGHT_TRUST=20
MATCH_WEIGHT_ACTIVITY=15

# ---------- File Uploads ----------
MAX_FILE_SIZE=5242880

# ---------- Logging ----------
LOG_LEVEL=debug

# Optional local abuse-detection model service
AI_MODEL_URL=http://127.0.0.1:8001/predict
